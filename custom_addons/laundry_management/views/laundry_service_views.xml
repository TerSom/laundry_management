<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="laundry_service_action" model="ir.actions.act_window">
        <field name="name">laundry.service.action</field>
        <field name="res_model">laundry.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="laundry_service_view_list" model="ir.ui.view">
        <field name="name">laundry.service.view.tree</field>
        <field name="model">laundry.service</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="price" />
                <field name="unit" />
            </list>
        </field>
    </record>

    <record id="laundry_service_view_form" model="ir.ui.view">
        <field name="name">laundry.service.view.form</field>
        <field name="model">laundry.service</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <div class="oe_title">
                        <field name="consumable_product_ids" widget="many2many_tags" options="{'color_field': 'color'}"></field>
                    </div>
                    <group>
                        <group>
                            <field name="unit" />
                            <field name="description" />
                        </group>
                        <group>
                            <field name="price" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page name="service options" string="Service Options">
                            <group>
                                <field name="need_dry" />
                                <field name="need_iron" />
                                <field name="need_wash" />
                                <field name="iron_duration" invisible='not need_iron' />
                                <field name="dry_duration" invisible='not need_dry'/>
                                <field name="wash_duration" invisible='not need_wash'/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>