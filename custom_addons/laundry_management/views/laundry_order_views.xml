<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="laundry_order_actions" model="ir.actions.act_window">
        <field name="name">landry.order.action</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <record id="laundry_order_view_list" model="ir.ui.view">
        <field name="name">laundry.order.view.list</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="name" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record id="laundry_order_view_form" model="ir.ui.view">
        <field name="name">laundry.order.view.form</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customer_order" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                            <field name="partner_id" widget="statinfo" string="Custumer"/>
                        </button>
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="picking_count" widget="statinfo" string="Inventory"/>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <header>
                        <button name="action_received" string="Received" type="object" class="btn-primary" invisible="next_stage != 'received'" />
                        <button name="action_washing" string="Washing" type="object" class="btn-primary" invisible="next_stage != 'washing'" />
                        <button name="action_drying" string="Drying" type="object" class="btn-primary" invisible="next_stage != 'drying'" />
                        <button name="action_ironing" string="Ironing" type="object" class="btn-primary" invisible="next_stage != 'ironing'" />
                        <button name="action_ready" string="Ready" type="object" class="btn-primary" invisible="next_stage != 'ready'" />
                        <button name="action_delivered" string="Delivered" type="object" class="btn-primary" invisible="next_stage != 'delivered'" />
                        <field name="state" widget="statusbar"/>
                    </header>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="date_received" />
                            <field name="total_duration" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_price" />
                            <field name="delivered_date" invisible="state != 'delivered'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids" />
                        </page>
                        <page string="Duration">
                            <group>
                                <field name="estimated_ready_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="laundry_order_view_calendar" model="ir.ui.view">
        <field name="name">laundry.order.view.calendar</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <calendar string="Laundry Schedule" date_start="date_received" date_stop="estimated_ready_date" color="state">
                <field name="name" />
                <field name="partner_id" />
                <field name="total_price"/>
                <field name="state" />
            </calendar>
        </field>
    </record>

</odoo>
